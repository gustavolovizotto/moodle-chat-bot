# Abra a conversa no Moodle e copie a URL (?id= é o usuário do contato; ?convid= também serve)
MOODLE_CHAT_URL=https://moodle.utfpr.edu.br/message/index.php?id=ID_DO_CONTATO

# auto = tenta a API do Moodle e cai para a leitura da tela | api | dom
MODE=auto

# haiku = mais rápido e gasta menos | sonnet | claude-opus-5-5 = o mais capaz, mais lento e gasta mais (requer Claude Code 2.1.280+)
CLAUDE_MODEL=haiku
# Esforço de raciocínio: low | medium | high | xhigh | max (vazio = padrão)
CLAUDE_EFFORT=
POLL_MS=3000
HEADLESS=false

# Marca de toda resposta do bot (também impede o bot de responder a si mesmo)
REPLY_PREFIX="🤖 "

# padrao = responde direto | tutor = dá pistas, pede sua resposta e corrige
PERSONA=padrao

# SYSTEM_PROMPT=Instrução personalizada para a IA (as regras de segurança são sempre adicionadas)

# Busca de atividades pelo chat (só na conversa consigo mesmo). Usa o moodle-estudos instalado ao lado.
# ESTUDOS_DIR=../moodle-estudos   vazio desliga a busca
# MAX_IMAGES=8                     imagens da atividade enviadas ao Claude por resposta

# Opcionais
# CLAUDE_BIN=claude              caminho do Claude Code, se não estiver no PATH
# BROWSER_CHANNEL=msedge         usar o Edge/Chrome instalado em vez do Chromium do Playwright
# MOODLE_USER_ID=12345           seu id no Moodle, se a API não conseguir descobrir sozinha
# HISTORY_SIZE=12                quantas mensagens recentes vão como contexto
# RELOAD_MS=20000                modo dom: de quanto em quanto tempo recarregar a tela

# Seletores do modo dom (confira com `npm run check`)
# SEL_MESSAGE=[data-region="message"]
# SEL_ID_ATTR=data-message-id
# SEL_TEXT=[data-region="text-container"]
# SEL_INPUT=[data-region="send-message-txt"]
# SEL_SEND=[data-action="send-message"]
# RECEIVED_CLASS=received
